    "settings.sync.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each refresh keeps paging past already-synced bookmarks until it imports up to the batch size of new ones (default 100), or there are no more on X. Deleting from X after sync is off by default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次刷新会跳过已同步书签并继续向后翻页，直到新抓取满设定条数（默认 100），或 X 上没有更多。默认同步后不从 X 删除。"
          }
        }
      }
    },
    "settings.syncBatchSizeFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New bookmarks per refresh: %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次刷新新抓取：%lld 条"
          }
        }
      }
    },
    "settings.syncSkipAlreadySynced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip already-synced, then fetch older ones (recommended)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过已同步，继续抓取更早的书签（推荐）"
          }
        }
      }
    },
    "settings.syncDeleteFromXAfterSync": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete from X after syncing locally (off by default)"
