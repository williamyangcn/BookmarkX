    "sync.status.completedFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetched %lld new, %lld updated, %lld restored, skipped %lld (target %lld new)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新抓取 %lld，更新 %lld，恢复 %lld，跳过 %lld（目标新增 %lld）。"
